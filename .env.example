# Server-side only. Obtain from your data.gov.in account profile.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# Local service endpoints (never put secrets in VITE_* variables).
API_PORT=8000
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
AUTO_INGEST_INTERVAL_SECONDS=3600
INGEST_TOKEN=replace-with-a-long-random-local-operator-token

# Public frontend configuration. Cognito values are created during AWS setup.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_AWS_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
